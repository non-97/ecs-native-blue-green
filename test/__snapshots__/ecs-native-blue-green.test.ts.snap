              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "FirelensConstructFireLensLongBucketE9569ADD",
                    "Arn",
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
