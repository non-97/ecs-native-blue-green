    "QDeveloperChatPostTestTrafficShiftApproveAction7797E540": {
      "Properties": {
        "ActionName": "PostTestTrafficShiftApprove",
        "AliasName": "post-test-traffic-approve",
        "Attachments": [
          {
            "ButtonText": "🔁 再ルーティング",
            "Criteria": [
              {
                "Operator": "HAS_VALUE",
                "VariableName": "hookId",
              },
              {
                "Operator": "EQUALS",
                "Value": "ecs-blue-green-deployment_POST_TEST_TRAFFIC_SHIFT",
                "VariableName": "ActionGroup",
              },
            ],
            "NotificationType": "Custom",
            "Variables": {
              "ActionGroup": "event.metadata.additionalContext.ActionGroup",
              "hookId": "event.metadata.additionalContext.hookId",
              "region": "event.metadata.additionalContext.region",
            },
          },
        ],
        "Definition": {
          "CommandText": "ecs continue-service-deployment --hook-id $hookId --action CONTINUE --region $region",
        },
      },
      "Type": "AWS::Chatbot::CustomAction",
    },
    "QDeveloperChatPostTestTrafficShiftRejectAction09644B58": {
      "Properties": {
        "ActionName": "PostTestTrafficShiftReject",
        "AliasName": "post-test-traffic-reject",
        "Attachments": [
          {
            "ButtonText": "⏪ ロールバック",
            "Criteria": [
              {
                "Operator": "HAS_VALUE",
                "VariableName": "hookId",
              },
              {
                "Operator": "EQUALS",
                "Value": "ecs-blue-green-deployment_POST_TEST_TRAFFIC_SHIFT",
                "VariableName": "ActionGroup",
              },
            ],
            "NotificationType": "Custom",
            "Variables": {
              "ActionGroup": "event.metadata.additionalContext.ActionGroup",
              "hookId": "event.metadata.additionalContext.hookId",
              "region": "event.metadata.additionalContext.region",
            },
          },
        ],
        "Definition": {
          "CommandText": "ecs continue-service-deployment --hook-id $hookId --action ROLLBACK --region $region",
        },
      },
      "Type": "AWS::Chatbot::CustomAction",
    },
    "QDeveloperChatSlackChannelA78F2523": {
      "Properties": {
        "ConfigurationName": "ecs-blue-green-deployment",
        "CustomizationResourceArns": [
          {
            "Ref": "QDeveloperChatPostTestTrafficShiftApproveAction7797E540",
