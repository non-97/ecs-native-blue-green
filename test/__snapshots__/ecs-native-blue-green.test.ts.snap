    "EcsConstructCluster14AE103B": {
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enhanced",
          },
        ],
        "Configuration": {
          "ExecuteCommandConfiguration": {
            "LogConfiguration": {
              "S3BucketName": {
                "Ref": "EcsConstructecsExecLogBucketConstruct76C260A9",
